{
  "version": "3.8.0",
  "incremental_learning": {
    "learning_rates": {
      "lgb": 0.01,
      "xgb": 0.005,
      "neural": 0.001
    },
    "forgetting_factors": {
      "short": 0.95,
      "medium": 0.98,
      "long": 0.99
    },
    "update_thresholds": {
      "performance_drop": 0.05,
      "data_drift": 0.1
    },
    "update_schedules": {
      "daily": "09:00",
      "realtime_interval": 300,
      "weekly_retrain": "Saturday 02:00"
    }
  },
  "realtime_features": {
    "cache_ttl": 300,
    "feature_types": [
      "intraday_momentum_5m",
      "intraday_momentum_15m",
      "intraday_momentum_30m",
      "opening_gap",
      "opening_volume_surge",
      "early_session_perf",
      "relative_sector_strength",
      "market_correlation",
      "volatility_intraday",
      "price_efficiency"
    ],
    "calculation_intervals": {
      "high_freq": 60,
      "medium_freq": 300,
      "low_freq": 900
    }
  },
  "adaptive_scoring": {
    "sensitivity_params": {
      "market_volatility_weight": 0.5,
      "confidence_threshold": 0.8
    },
    "score_ranges": {
      "high_confidence": [10, 90],
      "low_confidence": [20, 80]
    },
    "temporal_weights": {
      "short_term": 0.4,
      "medium_term": 0.35,
      "long_term": 0.25
    }
  },
  "monitoring": {
    "performance_metrics": [
      "mse",
      "mae",
      "r2_score",
      "prediction_accuracy",
      "model_drift"
    ],
    "alert_thresholds": {
      "performance_drop": 0.1,
      "drift_threshold": 0.15
    }
  }
}